node_modules/

# Build output: rebuilt by `pnpm run build` and on `pnpm pack`/publish.
dist/

# API keys. The example file is committed, the real one never is.
.env
.env.*
!.env.example

# Local configuration.
config.json
llm-proxy.config.json

# Persisted counters and cooldowns.
*.stats.json

# Background service: pid/port of the running instance, its output, and the
# copy of the CLI it runs from.
daemon.json
daemon.log
service/

# Cloudflare WARP state, when the configuration lives in this directory: the
# downloaded tunnel binaries, and — the reason this line exists — the WireGuard
# identity they run on. `wgcf-account.toml`, `wgcf-profile.conf` and
# `wireproxy.conf` all carry the private key.
#
# Anchored with a leading slash: unanchored, it would also match `src/warp/`,
# which is this feature's source code.
/warp/

*.log
coverage/
.DS_Store
test-log.txt
update.json
